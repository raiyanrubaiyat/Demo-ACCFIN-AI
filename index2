h1{font-size:21px;font-weight:600}.sub{color:var(--mute);font-size:13px;margin-top:2px}
.pad{padding:10px 24px 28px}.grid{display:grid;gap:14px}
.k{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}.c3{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}.c21{grid-template-columns:2fr 1fr}.c2{grid-template-columns:1fr 1fr}
